{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run verify)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run doctor)",
      "Bash(npx vitest run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Read(//home/**)",
      "Edit(src/**)",
      "Edit(docs/**)",
      "Edit(CLAUDE.md)"
    ],
    "deny": ["Bash(git push --force:*)", "Bash(rm -rf:*)", "Read(.env)", "Read(.env.*)"]
  }
}
